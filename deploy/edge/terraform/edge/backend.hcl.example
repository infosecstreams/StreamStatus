# terraform init -backend-config=backend.hcl
# Create the bucket once (RUNBOOK.md "State backend"), then copy this file to
# backend.hcl (git-ignored).
bucket       = "infosecstreams-tfstate-<account-id>"
key          = "edge/terraform.tfstate"
region       = "us-west-2"
encrypt      = true
use_lockfile = true
