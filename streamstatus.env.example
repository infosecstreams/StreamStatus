# Secret key to HMAC EventSub message
SS_SECRETKEY=abc321
# GitHub access to the site repo: a GitHub App (preferred) ...
#SS_GH_APP_ID=123456
#SS_GH_APP_INSTALLATION_ID=12345678
#SS_GH_APP_PRIVATE_KEY_PATH=/run/secrets/streamstatus-github-app.pem
# ... or, when the three SS_GH_APP_* are unset, a personal access token
SS_TOKEN=abc123
# GitHub username (PAT only)
SS_USERNAME=username
# Twitch Client ID
TW_CLIENT_ID=abc123
# Twitch Secret
TW_CLIENT_SECRET=abc321
# Optional: Discord channel webhook for errors and status alerts (keep it secret)
export SS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>
# Optional: public URL of /webhook/callbacks; when set the bot creates any missing
# stream.online, stream.offline and channel.update EventSub subscriptions
export SS_CALLBACK_URL=https://example.com/webhook/callbacks
# Optional: how often to re-check every streamer's live state against Helix (default 5m)
export SS_RECONCILE_INTERVAL=5m
# Optional: let reconciliation reactivate live streamers from inactive_streamers.csv (default false)
export SS_RECONCILE_INACTIVE=false
# Optional: SQLite file for live state and stream history behind /streamstatus/status.json
# (default /data/streamstatus.db; mount a volume at /data)
export SS_DB_PATH=/data/streamstatus.db
# Optional: commit live status changes to the site repo (default true). Set false once the
# site reads /streamstatus/status.json; reactivations of inactive streamers are still committed.
export SS_COMMIT_STATUS=true
# Optional: tracker history (bot-schedule's stream_history.json) to import as backfill for the time
# before recording started (default: stream_history.json next to SS_DB_PATH)
export SS_BACKFILL_PATH=/data/stream_history.json
# Optional: chat stats. Login of our own bot Twitch account, and a refresh token for it with the
# chat:read scope, issued to TW_CLIENT_ID (e.g. `twitch token -u -s chat:read`). Read-only; counts only.
export SS_CHAT_LOGIN=infosecstreams_bot
export SS_CHAT_REFRESH_TOKEN=abc123
